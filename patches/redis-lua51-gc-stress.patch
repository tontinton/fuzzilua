 #define lmem_c
@@ -18,6 +27,93 @@
 #include "lobject.h"
 #include "lstate.h"
 
+#ifdef FUZZILUA_GC_STRESS
+#include "lgc.h"
+
+#ifndef FUZZILUA_GC_STRESS_INTERVAL
+#define FUZZILUA_GC_STRESS_INTERVAL 1
+#endif
+
+#ifndef FUZZILUA_GC_STRESS_MODE
+#define FUZZILUA_GC_STRESS_MODE 1
+#endif
+
+#define FUZZILUA_GC_BITMAP_SIZE FUZZILUA_BITMAP_SIZE
+
+static uint8_t *fuzzilua_gc_bitmap = NULL;
+static uint32_t fuzzilua_gc_bitmap_size = 0;
+static uint32_t fuzzilua_alloc_counter = 0;
+
+__attribute__((constructor))
+static void fuzzilua_gc_init(void) {
+    const char *shm_name = getenv("FUZZILUA_SHM_GC");
+    if (!shm_name || shm_name[0] == '\0')
+        return;
+
+    int fd = shm_open(shm_name, O_RDWR, 0);
+    if (fd < 0)
+        return;
+
+    /* Layout: [edge (FUZZILUA_BITMAP_SIZE) | gc (FUZZILUA_BITMAP_SIZE)] */
+    size_t total_size = FUZZILUA_GC_BITMAP_SIZE * 2;
+    uint8_t *base = (uint8_t *)mmap(NULL, total_size, PROT_READ | PROT_WRITE,
+                                     MAP_SHARED, fd, 0);
+    close(fd);
+
+    if (base == MAP_FAILED)
+        return;
+
+    fuzzilua_gc_bitmap = base + FUZZILUA_GC_BITMAP_SIZE;
+    fuzzilua_gc_bitmap_size = FUZZILUA_GC_BITMAP_SIZE;
+}
+
+static inline uint32_t fuzzilua_gc_hash(uintptr_t alloc_site,
+                                         uint8_t gc_phase,
+                                         uint32_t gc_debt_bucket) {
+    uint32_t h = (uint32_t)(alloc_site >> 4);
+    h ^= (uint32_t)gc_phase * 0x9e3779b1u;
+    h ^= gc_debt_bucket * 0x517cc1b7u;
+    return h;
+}
+
+/* Bucket the GC debt (gcdept) into coarse ranges.
+ * Lua 5.1 gcdept is lu_mem (unsigned), represents how far behind GC is. */
+static inline uint32_t fuzzilua_debt_bucket(lu_mem debt) {
+    if (debt == 0) return 0;
+    if (debt < 1024) return 1;
+    if (debt < 16384) return 2;
+    return 3;
+}
+
+static inline void fuzzilua_record_gc_coverage(lua_State *L,
+                                                uintptr_t alloc_site) {
+    if (!fuzzilua_gc_bitmap)
+        return;
+
+    global_State *g = G(L);
+    uint8_t phase = (uint8_t)g->gcstate;
+    uint32_t bucket = fuzzilua_debt_bucket(g->gcdept);
+    uint32_t idx = fuzzilua_gc_hash(alloc_site, phase, bucket)
+                   % fuzzilua_gc_bitmap_size;
+
+    uint8_t old = fuzzilua_gc_bitmap[idx];
+    if (old < 255)
+        fuzzilua_gc_bitmap[idx] = old + 1;
+}
+
+static inline void fuzzilua_gc_stress_hook(lua_State *L) {
+    if (++fuzzilua_alloc_counter >= FUZZILUA_GC_STRESS_INTERVAL) {
+        fuzzilua_alloc_counter = 0;
+#if FUZZILUA_GC_STRESS_MODE == 0
+        luaC_fullgc(L);
+#else
+        luaC_step(L);
+#endif
+    }
+}
+
+#endif /* FUZZILUA_GC_STRESS */
+
 
 
