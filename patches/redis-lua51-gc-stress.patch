@@ -81,6 +177,13 @@ void *luaM_realloc_ (lua_State *L, void *block, size_t osize, size_t nsize) {
     luaD_throw(L, LUA_ERRMEM);
   lua_assert((nsize == 0) == (block == NULL));
   g->totalbytes = (g->totalbytes - osize) + nsize;
+
+#ifdef FUZZILUA_GC_STRESS
+  if (nsize > 0) {
+    fuzzilua_record_gc_coverage(L, (uintptr_t)__builtin_return_address(0));
+    fuzzilua_gc_stress_hook(L);
+  }
+#endif
   return block;
 }
 
