@@ -18,6 +22,42 @@
 #include "lobject.h"
 #include "lstate.h"
 
+#ifdef FUZZILUA_ALLOC_FAIL
+
+/* Allocation failure injection for error-path fuzzing.
+ *
+ * When enabled, luaM_realloc_ randomly returns NULL for new allocations
+ * (not frees or shrinks) with probability set by FUZZILUA_ALLOC_FAIL_PROB.
+ * This exercises Lua's OOM error paths, surfacing UaF, double-free, and
+ * use-of-uninitialized bugs in cleanup code.
+ *
+ * Can be combined with GC stress (both patches active simultaneously). */
+
+static double fuzzilua_alloc_fail_prob = 0.0;
+static unsigned int fuzzilua_alloc_fail_seed = 0;
+static int fuzzilua_alloc_fail_inited = 0;
+
+static void fuzzilua_alloc_fail_init(void) {
+    if (fuzzilua_alloc_fail_inited)
+        return;
+    fuzzilua_alloc_fail_inited = 1;
+
+    const char *env = getenv("FUZZILUA_ALLOC_FAIL_PROB");
+    if (env && env[0] != '\0')
+        fuzzilua_alloc_fail_prob = strtod(env, NULL);
+
+    fuzzilua_alloc_fail_seed = (unsigned int)getpid() ^ 0xdeadbeef;
+}
+
+/* xorshift32 PRNG -- fast, no state beyond a single uint32 */
+static int fuzzilua_should_fail(void) {
+    if (fuzzilua_alloc_fail_prob <= 0.0)
+        return 0;
+    fuzzilua_alloc_fail_seed ^= fuzzilua_alloc_fail_seed << 13;
+    fuzzilua_alloc_fail_seed ^= fuzzilua_alloc_fail_seed >> 17;
+    fuzzilua_alloc_fail_seed ^= fuzzilua_alloc_fail_seed << 5;
+    double r = (double)fuzzilua_alloc_fail_seed / (double)0xFFFFFFFFu;
+    return r < fuzzilua_alloc_fail_prob;
+}
+
+#endif /* FUZZILUA_ALLOC_FAIL */
 
 
 /*
@@ -81,6 +121,14 @@ void *luaM_realloc_ (lua_State *L, void *block, size_t osize, size_t nsize) {
   global_State *g = G(L);
   lua_assert((nsize == 0) == (block == NULL));
   block = (*g->frealloc)(g->ud, block, osize, nsize);
+#ifdef FUZZILUA_ALLOC_FAIL
+  if (nsize > 0 && nsize >= osize) {
+    fuzzilua_alloc_fail_init();
+    if (block != NULL && fuzzilua_should_fail()) {
+      block = NULL;
+    }
+  }
+#endif
   if (block == NULL && nsize > 0)
     luaD_throw(L, LUA_ERRMEM);
   lua_assert((nsize == 0) == (block == NULL));
